[Unit]
Description=The Bowery agent
Documentation=https://github.com/jvehent/the-bowery
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/bowery-agent --config /etc/bowery/agent.toml
Restart=on-failure
RestartSec=5s

# Resource isolation. Phase 0 ships a deliberately tight envelope; later phases
# raise these for the LLM analyzer (see DESIGN.md §6.4).
Slice=bowery.slice
MemoryHigh=512M
MemoryMax=1G
CPUWeight=100
TasksMax=256

# Capabilities. The eBPF loader needs CAP_BPF + CAP_PERFMON to load
# tracepoint programs and create ring-buffer maps. CAP_SYS_ADMIN is
# required as a fallback on kernels without CAP_BPF granularity
# (< 5.8). CAP_KILL lets the process-kill response engine SIGKILL a
# flagged process owned by another uid — WITHOUT it, kill(2) returns
# EPERM against any non-root target (the common malware case) and
# enforcement silently no-ops, giving false assurance of containment.
#
# Note: NoNewPrivileges interacts with eBPF — when set, only programs
# whose perf event creation is allowed for unprivileged users will
# load. For our tracepoints and ring buffers it's compatible. Keep
# the rest of the hardening intact.
#
# TODO(hardening): the agent currently retains these caps for its whole
# lifetime — it does NOT drop CAP_SYS_ADMIN after BPF load. Dropping to
# CAP_BPF+CAP_PERFMON+CAP_KILL post-load (and removing CAP_SYS_ADMIN on
# kernels ≥ 5.8) is tracked as a follow-up.
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_SYS_ADMIN CAP_NET_ADMIN CAP_KILL
AmbientCapabilities=CAP_BPF CAP_PERFMON CAP_SYS_ADMIN CAP_NET_ADMIN CAP_KILL
NoNewPrivileges=yes

# Filesystem hardening.
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/bowery /var/log/bowery
ConfigurationDirectory=bowery
StateDirectory=bowery
LogsDirectory=bowery

# Network. Allow IPv4/IPv6 + Unix; later phases may tighten.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

# System call filter. Start from @system-service, then deny the
# @privileged and @resources groups, then re-allow the specific
# privileged syscalls the agent genuinely needs. Order matters: the
# re-allow lines come AFTER the ~deny so they win.
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# Re-allow the chown family. The agent runs as root and its SQLite
# baseline, when creating the WAL/SHM (or rollback journal) as root,
# fchown()s those aux files to match the DB owner. fchown is not in
# @system-service, so without this the agent is SIGSYS-killed at
# baseline init (systemd: code=killed, status=31/SYS; audit: aarch64
# syscall 55 / x86_64 syscall 93 = fchown).
SystemCallFilter=@chown
# Re-allow the eBPF load path. On a BPF-LSM (KRSI) host the agent calls
# bpf(2) to load its tracepoint/LSM programs and create ring-buffer maps,
# and perf_event_open(2) to attach the tracepoints. Both live in
# @privileged (denied above), so without this the agent SIGSYS-crashloops
# the instant it finds the BPF object at /usr/local/lib/bowery/bowery-ebpf
# (same class of failure as the fchown one). Hosts without the object run
# NoopEventSource and never hit these — the allowance is harmless there.
SystemCallFilter=bpf perf_event_open

[Install]
WantedBy=multi-user.target
