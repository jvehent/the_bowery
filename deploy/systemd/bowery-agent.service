[Unit]
Description=The Bowery agent
Documentation=https://github.com/jvehent/the-bowery
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/bowery-agent --config /etc/bowery/agent.toml
Restart=on-failure
RestartSec=5s

# Resource isolation. Phase 0 ships a deliberately tight envelope; later phases
# raise these for the LLM analyzer (see DESIGN.md §6.4).
Slice=bowery.slice
MemoryHigh=512M
MemoryMax=1G
CPUWeight=100
TasksMax=256

# Capabilities — the minimal set the agent actually needs:
#   CAP_BPF + CAP_PERFMON  load tracepoint programs + create ring-buffer
#                          maps + attach tracepoints (the whole KRSI ≥ 5.8
#                          model; no CAP_SYS_ADMIN needed at that granularity).
#   CAP_NET_ADMIN          network-side observation.
#   CAP_KILL               process-kill response engine SIGKILLs a flagged
#                          process owned by another uid; without it kill(2)
#                          returns EPERM against any non-root target and
#                          enforcement silently no-ops (false containment).
#   CAP_SYS_PTRACE         resolve OTHER processes' /proc entries (readlink
#                          /proc/<pid>/exe for exec enrichment, /proc/<pid>/fd
#                          for process_open_sockets). Without it,
#                          ptrace_may_access() denies a root-but-capability-
#                          restricted agent access to any process owned by a
#                          different uid, so non-root execs never populate the
#                          baseline.
#
# CAP_SYS_ADMIN was REMOVED (audit finding #7): it's only a pre-CAP_BPF
# (< 5.8) fallback, and any host that passes `bowery doctor` (BPF-LSM,
# kernel ≥ 5.13) has CAP_BPF granularity. If you must support a < 5.8
# kernel, add CAP_SYS_ADMIN back here.
#
# AmbientCapabilities was REMOVED: a root service already receives its
# effective caps from the bounding set (kernel root rule), so ambient added
# nothing for the agent itself — it only leaked these caps into any child
# the agent might exec. The agent execs no privileged children, so dropping
# ambient is a pure hardening win.
#
# NOTE: enabling the `bpf-lsm` block-exec ENGINE (not the default) also
# needs CAP_MAC_ADMIN to attach the LSM program — add it if you turn that on.
#
# NoNewPrivileges interacts with eBPF — when set, only programs whose perf
# event creation is allowed for unprivileged users will load; our tracepoints
# and ring buffers are compatible. Keep the rest of the hardening intact.
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_NET_ADMIN CAP_KILL CAP_SYS_PTRACE
NoNewPrivileges=yes

# Filesystem hardening.
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/bowery /var/log/bowery
ConfigurationDirectory=bowery
StateDirectory=bowery
LogsDirectory=bowery

# Network. Allow IPv4/IPv6 + Unix; later phases may tighten.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

# System call filter. Start from @system-service, then deny the
# @privileged and @resources groups, then re-allow the specific
# privileged syscalls the agent genuinely needs. Order matters: the
# re-allow lines come AFTER the ~deny so they win.
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# Re-allow the chown family. The agent runs as root and its SQLite
# baseline, when creating the WAL/SHM (or rollback journal) as root,
# fchown()s those aux files to match the DB owner. fchown is not in
# @system-service, so without this the agent is SIGSYS-killed at
# baseline init (systemd: code=killed, status=31/SYS; audit: aarch64
# syscall 55 / x86_64 syscall 93 = fchown).
SystemCallFilter=@chown
# Re-allow the eBPF load path. On a BPF-LSM (KRSI) host the agent calls
# bpf(2) to load its tracepoint/LSM programs and create ring-buffer maps,
# and perf_event_open(2) to attach the tracepoints. Both live in
# @privileged (denied above), so without this the agent SIGSYS-crashloops
# the instant it finds the BPF object at /usr/local/lib/bowery/bowery-ebpf
# (same class of failure as the fchown one). Hosts without the object run
# NoopEventSource and never hit these — the allowance is harmless there.
SystemCallFilter=bpf perf_event_open

[Install]
WantedBy=multi-user.target
