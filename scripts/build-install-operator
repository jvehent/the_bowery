#!/usr/bin/env bash
# build-install-operator — build the CLI, console, and agent with every
# feature enabled, install them on THIS machine, and restart the agent.
#
# For an operator workstation that is also a monitored node (the
# "combined agent + operator" host). Builds natively — this is NOT the
# path for the Raspberry Pis; those get a cross-compiled, feature-light
# tarball from deploy/remote/package-agent.sh.
#
# What "all features" means here:
#   bowery-agent    llm-llama-cpp (real Qwen3 inference) + yara (libyara)
#   bowery-console  llm-llama-cpp (real Gemma 4 chatbot)
#   bowery          (no optional features)
#
# Everything is built with `-C target-cpu=native`, because llama.cpp's
# CPU dispatch can otherwise select an AVX path the running core doesn't
# have and die with SIGILL and no Rust error. That makes these binaries
# NON-PORTABLE: they are tuned for this machine's CPU. Don't copy them
# to a host with a different processor.
#
# Usage:
#   ./scripts/build-install-operator                 # build + install + restart
#   ./scripts/build-install-operator --no-console    # skip the slow llama.cpp console
#   ./scripts/build-install-operator --no-agent      # operator tools only
#   ./scripts/build-install-operator --no-restart    # install but leave the agent running old code
#   ./scripts/build-install-operator --skip-unit     # don't refresh the systemd unit/drop-in
#   ./scripts/build-install-operator --dry-run       # show what would happen
#   ./scripts/build-install-operator --skip-toolchain-check  # bypass the cmake/clang probe

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

BIN_DIR="${BOWERY_BIN_DIR:-/usr/bin}"
DO_AGENT=1
DO_CONSOLE=1
DO_RESTART=1
DO_UNIT=1
DRY_RUN=0
SKIP_TOOLCHAIN_CHECK=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        --no-agent)   DO_AGENT=0 ;;
        --no-console) DO_CONSOLE=0 ;;
        --no-restart) DO_RESTART=0 ;;
        --skip-unit)  DO_UNIT=0 ;;
        --dry-run)    DRY_RUN=1 ;;
        --skip-toolchain-check) SKIP_TOOLCHAIN_CHECK=1 ;;
        -h|--help)    sed -n '2,30p' "$0"; exit 0 ;;
        *) echo "error: unknown option $1 (try --help)" >&2; exit 2 ;;
    esac
    shift
done

run() {
    if [[ "$DRY_RUN" == 1 ]]; then
        echo "  [dry-run] $*"
    else
        "$@"
    fi
}

# ---------------------------------------------------------------------------
# Toolchain pre-checks. Both LLM features compile llama.cpp (cmake) and
# run bindgen (libclang); libyara needs a C compiler. Missing pieces
# surface as a deep, confusing panic (e.g. `'stdbool.h' file not found`),
# so fail early with the exact fix.
# ---------------------------------------------------------------------------
# Locating libclang is fiddly: distros scatter it across
# /usr/lib/<triplet>/, /usr/lib/llvm-<ver>/lib/, /usr/lib64/, and a bare
# glob of /usr/lib misses the LLVM-versioned directory Ubuntu uses. Probe
# the way bindgen itself resolves it, most authoritative first, so an
# installed toolchain is never reported missing.
have_libclang() {
    if [[ -n "${LIBCLANG_PATH:-}" ]] && compgen -G "${LIBCLANG_PATH}/libclang*.so*" >/dev/null; then
        return 0
    fi
    if command -v ldconfig >/dev/null 2>&1 && ldconfig -p 2>/dev/null | grep -q 'libclang[.-]'; then
        return 0
    fi
    local lc d
    for lc in llvm-config llvm-config-20 llvm-config-19 llvm-config-18 \
              llvm-config-17 llvm-config-16 llvm-config-15 llvm-config-14; do
        if command -v "$lc" >/dev/null 2>&1; then
            d="$("$lc" --libdir 2>/dev/null || true)"
            if [[ -n "$d" ]] && compgen -G "$d/libclang*.so*" >/dev/null; then
                return 0
            fi
        fi
    done
    local g
    for g in /usr/lib/libclang*.so* /usr/lib64/libclang*.so* \
             /usr/lib/*/libclang*.so* /usr/lib/llvm-*/lib/libclang*.so* \
             /usr/lib64/llvm-*/lib/libclang*.so* /usr/local/lib/libclang*.so*; do
        if compgen -G "$g" >/dev/null; then
            return 0
        fi
    done
    return 1
}

missing=()
need_tools=(cc)
if [[ "$DO_CONSOLE" == 1 || "$DO_AGENT" == 1 ]]; then
    need_tools+=(cmake clang)
fi
for tool in "${need_tools[@]}"; do
    command -v "$tool" >/dev/null 2>&1 || missing+=("$tool")
done
if [[ "$DO_CONSOLE" == 1 || "$DO_AGENT" == 1 ]] && ! have_libclang; then
    missing+=("libclang")
fi
if [[ ${#missing[@]} -gt 0 && "$SKIP_TOOLCHAIN_CHECK" == 1 ]]; then
    echo "warning: toolchain probe reported missing: ${missing[*]} — continuing anyway" >&2
    missing=()
fi
if [[ ${#missing[@]} -gt 0 ]]; then
    cat >&2 <<EOF
error: the LLM (llama.cpp) and YARA features need a C/C++/clang toolchain
       that isn't fully installed. Missing: ${missing[*]}

  Debian/Ubuntu:  sudo apt install -y cmake clang libclang-dev build-essential
  Fedora/RHEL:    sudo dnf install -y cmake clang clang-devel gcc-c++

If it IS installed and this probe is wrong, point bindgen at it explicitly:
  LIBCLANG_PATH=\$(llvm-config --libdir) ./scripts/build-install-operator
or bypass the check entirely with --skip-toolchain-check.
EOF
    exit 1
fi

command -v cargo >/dev/null 2>&1 || {
    echo "error: cargo not on PATH (source \$HOME/.cargo/env?)" >&2
    exit 1
}

# ---------------------------------------------------------------------------
# Build. `-C target-cpu=native` for every binary so the llama.cpp-linked
# ones can't SIGILL on a CPU-dispatch mismatch.
# ---------------------------------------------------------------------------
export RUSTFLAGS="${RUSTFLAGS:-} -C target-cpu=native"

# libyara links OpenSSL by default (for its `hash` module and PE
# signature checks). We disable crypto rather than take on an OpenSSL
# build dependency. Set here rather than in .cargo/config.toml: a
# workspace [env] block silently breaks `cross`'s metadata call, which
# sends the Pi cross-build to the host toolchain instead of the
# container. Consequence: YARA rules can't use the `hash` module — use
# the bowery_file_sha256_hex SQL function instead.
export YARA_CRYPTO_LIB="${YARA_CRYPTO_LIB:-disable}"

echo "==> building bowery CLI (release)"
run cargo build --release -p bowery-cli

if [[ "$DO_AGENT" == 1 ]]; then
    echo "==> building bowery-agent (release, llm-llama-cpp + yara)"
    echo "    note: first build compiles llama.cpp and libyara — several minutes"
    run cargo build --release -p bowery-agent --features llm-llama-cpp,yara
fi

if [[ "$DO_CONSOLE" == 1 ]]; then
    echo "==> building bowery-console (release, llm-llama-cpp)"
    run cargo build --release -p bowery-console --features llm-llama-cpp
fi

# Smoke-test each binary before it replaces a working one. A binary that
# won't even run (bad CPU flags, missing shared lib) must not be
# installed over the one currently keeping the host monitored.
smoke() {
    local bin="$1"
    if [[ "$DRY_RUN" == 1 ]]; then return 0; fi
    if ! "$bin" --version >/dev/null 2>&1 && ! "$bin" --help >/dev/null 2>&1; then
        echo "error: $bin was built but won't run — refusing to install it" >&2
        exit 1
    fi
}
smoke target/release/bowery
if [[ "$DO_AGENT" == 1 ]]; then smoke target/release/bowery-agent; fi
if [[ "$DO_CONSOLE" == 1 ]]; then smoke target/release/bowery-console; fi

# ---------------------------------------------------------------------------
# Install, through dpkg where we can.
#
# `install`ing into /usr/bin leaves a binary owned by no package, and the
# agent's own provenance check then scores it Unpackaged — which on this
# very host made /usr/bin/bowery the single highest-suspicion thing the
# fleet reported. The detection was right; a binary in /usr/bin that no
# package owns genuinely is the shape it looks for. The deploy method was
# wrong, and it was wrong here long after deploy/remote/ was fixed.
#
# ONE PACKAGE PER BINARY, deliberately. A single package whose contents
# depend on --no-agent / --no-console would make dpkg *remove* whatever
# this run didn't build: `--no-console` would silently uninstall the
# console. Separate packages are each installed only when built, and
# skipping one leaves it alone.
#
# The eBPF object is deliberately NOT packaged here, unlike the remote
# path. It lives at /usr/local/lib/bowery, the loader searches there
# first, and moving it would mean dancing around a stale copy shadowing
# the new one — for no gain, since a data file in /usr/local was never
# what triggered the alerts.
# ---------------------------------------------------------------------------
DEB_VERSION="$(grep -m1 '^version' Cargo.toml | sed 's/.*"\(.*\)".*/\1/')~native"
DEB_ARCH="$(dpkg --print-architecture 2>/dev/null || echo amd64)"
DEB_STAGE="target/deb"

# make_deb <pkg> <summary> <src>...
# Each <src> is installed to $BIN_DIR/<basename>.
make_deb() {
    local pkg="$1" summary="$2"; shift 2
    local root="$DEB_STAGE/$pkg"
    rm -rf "$root"
    install -d -m0755 "$root/DEBIAN" "$root${BIN_DIR}"
    local f
    for f in "$@"; do
        install -m0755 "$f" "$root${BIN_DIR}/$(basename "$f")"
    done
    cat > "$root/DEBIAN/control" <<EOF
Package: $pkg
Version: $DEB_VERSION
Section: admin
Priority: optional
Architecture: $DEB_ARCH
Maintainer: The Bowery <noreply@example.invalid>
Description: $summary
 Built on this host with -C target-cpu=native and therefore NOT
 portable: llama.cpp's CPU dispatch can select an instruction path a
 different core lacks and die with SIGILL. Do not copy this package to
 another machine; use deploy/remote/package-agent.sh for those.
EOF
    # The whole point. dpkg installs this to /var/lib/dpkg/info/, which
    # is exactly the file the agent's provenance index reads — so these
    # binaries become PackagedIntact, and a *modified* copy of one
    # becomes a finding.
    ( cd "$root" && find . -type f -not -path "./DEBIAN/*" -printf "%P\0" \
        | LC_ALL=C sort -z | xargs -0 md5sum > DEBIAN/md5sums )
    dpkg-deb --root-owner-group --build "$root" "$DEB_STAGE/${pkg}_${DEB_VERSION}_${DEB_ARCH}.deb" >/dev/null
    echo "$DEB_STAGE/${pkg}_${DEB_VERSION}_${DEB_ARCH}.deb"
}

echo
if command -v dpkg-deb >/dev/null 2>&1 && command -v dpkg >/dev/null 2>&1; then
    echo "==> packaging + installing via dpkg (sudo)"
    if [[ "$DRY_RUN" == 1 ]]; then
        echo "  [dry-run] build .deb for bowery$([[ $DO_CONSOLE == 1 ]] && echo ', bowery-console')$([[ $DO_AGENT == 1 ]] && echo ', bowery-agent') and dpkg -i each"
    else
        DEBS=("$(make_deb bowery "The Bowery operator CLI" target/release/bowery)")
        if [[ "$DO_CONSOLE" == 1 ]]; then
            DEBS+=("$(make_deb bowery-console "The Bowery operator console" target/release/bowery-console)")
        fi
        if [[ "$DO_AGENT" == 1 ]]; then
            DEBS+=("$(make_deb bowery-agent "The Bowery agent (llm-llama-cpp + yara)" target/release/bowery-agent)")
        fi
        sudo dpkg -i "${DEBS[@]}"
    fi
else
    echo "==> installing into $BIN_DIR (sudo; dpkg not available)"
    echo "    NOTE: without dpkg these binaries stay unowned by any package, so"
    echo "          the agent will score them as unpackaged newcomers and alert"
    echo "          on its own tooling."
    run sudo install -m0755 target/release/bowery "$BIN_DIR/bowery"
    if [[ "$DO_CONSOLE" == 1 ]]; then
        run sudo install -m0755 target/release/bowery-console "$BIN_DIR/bowery-console"
    fi
    if [[ "$DO_AGENT" == 1 ]]; then
        run sudo install -m0755 target/release/bowery-agent "$BIN_DIR/bowery-agent"
    fi
fi

if [[ "$DO_AGENT" == 1 ]]; then

    # The eBPF object is loaded from disk at runtime, NOT embedded in the
    # binary, so installing the agent alone leaves the kernel program at
    # whatever version was there before. That skew is invisible until an
    # event record changes size, at which point every event of that kind
    # is silently discarded. Keep the two in lockstep.
    EBPF_OBJ="crates/bowery-ebpf/target/bpfel-unknown-none/release/bowery-ebpf"
    if [[ -f "$EBPF_OBJ" ]]; then
        if [[ "$EBPF_OBJ" -ot target/release/bowery-agent ]]; then
            echo "    WARNING: $EBPF_OBJ is older than the agent binary."
            echo "             Run scripts/build-ebpf first if the eBPF source changed."
        fi
        run sudo install -d -m0755 /usr/local/lib/bowery
        run sudo install -m0644 "$EBPF_OBJ" /usr/local/lib/bowery/bowery-ebpf
        echo "    installed eBPF object -> /usr/local/lib/bowery/bowery-ebpf"
    else
        echo "    NOTE: no eBPF object at $EBPF_OBJ; leaving the installed one in place."
        echo "          Build it with scripts/build-ebpf if you changed kernel-side code."
    fi
fi

# Refresh the systemd unit + remote drop-in. This is what makes
# capability/seccomp changes (CAP_SYS_PTRACE for /proc enrichment,
# bpf+perf_event_open for the eBPF load path) actually take effect — a
# new binary alone won't pick them up.
if [[ "$DO_AGENT" == 1 && "$DO_UNIT" == 1 ]]; then
    echo "==> refreshing systemd unit + drop-in"
    run sudo install -m0644 deploy/systemd/bowery-agent.service \
        /lib/systemd/system/bowery-agent.service
    if [[ -f deploy/systemd/bowery.slice ]]; then
        run sudo install -m0644 deploy/systemd/bowery.slice /lib/systemd/system/bowery.slice
    fi
    run sudo install -d -m0755 /etc/systemd/system/bowery-agent.service.d
    run sudo install -m0644 deploy/remote/10-remote-node.conf \
        /etc/systemd/system/bowery-agent.service.d/10-remote-node.conf
    run sudo systemctl daemon-reload
fi

# ---------------------------------------------------------------------------
# Restart + verify. A silent restart isn't good enough: the agent can
# come back up "active" while its eBPF source failed to attach, so print
# the lines that actually prove it.
# ---------------------------------------------------------------------------
if [[ "$DO_AGENT" == 1 && "$DO_RESTART" == 1 ]]; then
    echo "==> restarting bowery-agent"
    run sudo systemctl restart bowery-agent
    if [[ "$DRY_RUN" == 0 ]]; then
        sleep 2
        if ! systemctl is-active --quiet bowery-agent; then
            echo "error: bowery-agent did not come back up. Recent log:" >&2
            journalctl -u bowery-agent -n 30 --no-pager >&2
            exit 1
        fi
        echo
        echo "==> agent status"
        journalctl -u bowery-agent -b --no-pager -n 200 \
            | grep -iE 'agent ready|attached BPF|attached tracepoint|BPF source exited|unavailable|monitoring rules|yara rules|SIGSYS|status=31' \
            | tail -12 || true
    fi
fi

echo
echo "installed:"
echo "  $BIN_DIR/bowery"
if [[ "$DO_CONSOLE" == 1 ]]; then echo "  $BIN_DIR/bowery-console"; fi
if [[ "$DO_AGENT" == 1 ]]; then echo "  $BIN_DIR/bowery-agent   (llm-llama-cpp + yara)"; fi
cat <<'EOF'

notes:
  - These binaries are built for THIS machine's CPU (-C target-cpu=native).
    Don't copy them to another host; use deploy/remote/package-agent.sh for
    the Raspberry Pis (cross-compiled, static musl, features off).
  - The agent's llm-llama-cpp feature only enables the code path. Real
    inference also needs a GGUF plus an [llm.llama_cpp] block in
    /etc/bowery/agent.toml; without it the agent stays on the mock backend.
  - libyara here is built with crypto disabled, so YARA rules cannot use the
    `hash` module. Use the bowery_file_sha256_hex SQL function instead.
EOF
