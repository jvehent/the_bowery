#!/usr/bin/env bash
# build-ebpf — compile the bowery-ebpf crate for the BPF target.
#
# The eBPF crate is its own workspace because it builds for
# bpfel-unknown-none (BPF bytecode), needs the unstable `build-std`
# feature, and depends on `bpf-linker`. Keeping it separate prevents
# the parent workspace from inheriting any of that.
#
# Output: crates/bowery-ebpf/target/bpfel-unknown-none/release/bowery-ebpf
#
# Requirements (one-time, installed by `scripts/xtest setup`):
#   - The PINNED nightly + rust-src (crates/bowery-ebpf/rust-toolchain.toml;
#     rustup auto-installs it). The pin exists because bpf-linker is coupled
#     to an LLVM major version — see that file.
#   - bpf-linker (cargo install bpf-linker), able to load LLVM matching the
#     pinned nightly (LLVM 22 for bpf-linker 0.10.4). On Ubuntu that means
#     either a system LLVM 22 (`apt install llvm`) or the toolchain's
#     libLLVM via `rustup component add rustc-dev llvm-tools`. Note: if the
#     toolchain's libLLVM-<ver>.so is a GNU-ld `INPUT(...)` stub instead of
#     a symlink to the real libLLVM.so.*, recreate it as a symlink.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
EBPF_DIR="$REPO_ROOT/crates/bowery-ebpf"

if ! command -v bpf-linker >/dev/null; then
    echo "error: bpf-linker not found on PATH" >&2
    echo "       install with: cargo install bpf-linker" >&2
    exit 1
fi

cd "$EBPF_DIR"
# No `+nightly` override — the crate's rust-toolchain.toml pins the exact
# nightly (LLVM major must match bpf-linker's llvm-sys). rustup honors it
# and auto-installs it on first use.
cargo build --release "$@"

OUT="$EBPF_DIR/target/bpfel-unknown-none/release/bowery-ebpf"
if [[ ! -f "$OUT" ]]; then
    echo "error: build succeeded but $OUT is missing" >&2
    exit 1
fi

# The build can "succeed" yet emit an UNUSABLE object: bpf-linker silently
# produces a BTF-less object when debug info is missing or when it can't
# load LLVM (a "dlopen failed" warning above). The agent's loader needs
# BTF (CO-RE relocations + the LSM program), so reject a BTF-less object
# here instead of letting it fail cryptically at agent startup.
if command -v readelf >/dev/null 2>&1; then
    if ! readelf -S "$OUT" 2>/dev/null | grep -q '\.BTF'; then
        echo "error: $OUT has no .BTF section — the agent cannot load it." >&2
        echo "  Likely causes:" >&2
        echo "   - [profile.release] debug must be >= 1 (this crate pins debug = 2)" >&2
        echo "   - bpf-linker could not load LLVM: look for 'unable to open LLVM" >&2
        echo "     shared lib ... dlopen failed' above. The toolchain's" >&2
        echo "     libLLVM-<ver>.so may be a GNU-ld 'INPUT(...)' stub rather than" >&2
        echo "     a symlink to the real libLLVM.so.* — recreate it as a symlink." >&2
        exit 1
    fi
else
    echo "warning: readelf not found; skipping .BTF verification" >&2
fi

echo
echo "built $OUT (.BTF verified)"
ls -lh "$OUT"
