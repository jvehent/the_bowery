#!/usr/bin/env bash
# build-console — build the operator console with the real Gemma 4
# chatbot (llama.cpp) enabled, using the CPU the build host runs on.
#
# Why this wrapper exists:
#   The `llm-llama-cpp` feature links llama.cpp, whose bundled CPU
#   dispatch can select an AVX/AVX-512 code path the *running* core
#   doesn't support — the process then dies with SIGILL ("Illegal
#   instruction (core dumped)") and no Rust-level error. Forcing
#   `-C target-cpu=native` pins the build to the exact CPU it will
#   run on, which removes the mismatch. This is the same flag the
#   agent's LLM build uses (see scripts/xtest).
#
#   Because the flag targets the *build* host's CPU, the resulting
#   binary is NOT portable — build it on the workstation you'll run
#   the console on (the normal case for an operator). Do not ship
#   this binary to a machine with a different CPU.
#
# Output: target/release/bowery-console
#
# Extra args are forwarded to cargo, e.g.:
#   ./scripts/build-console --locked

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

# The llm-llama-cpp feature compiles llama.cpp (cmake) and runs bindgen
# (libclang). Missing pieces surface as a deep panic like
# `'stdbool.h' file not found` — pre-check and give the exact fix.
missing=()
for tool in cmake clang cc; do command -v "$tool" >/dev/null 2>&1 || missing+=("$tool"); done
# libclang.so is a library, not a command — probe common locations.
if ! ls /usr/lib*/libclang*.so* /usr/lib/*/libclang*.so* >/dev/null 2>&1; then
    missing+=("libclang")
fi
if [[ ${#missing[@]} -gt 0 ]]; then
    cat >&2 <<EOF
error: the console's LLM (Gemma 4) feature needs a C/C++/clang toolchain
       that isn't fully installed. Missing: ${missing[*]}

  Debian/Ubuntu:  sudo apt install -y cmake clang libclang-dev build-essential
  Fedora/RHEL:    sudo dnf install -y cmake clang clang-devel gcc-c++

Or build the console WITHOUT the chatbot (all other panes work; Chat is a
mock) — no cmake/clang needed:

  cargo build --release -p bowery-console
EOF
    exit 1
fi

echo "==> building bowery-console (release, llm-llama-cpp, target-cpu=native)"
RUSTFLAGS="-C target-cpu=native" \
    cargo build --release -p bowery-console --features llm-llama-cpp "$@"

echo
echo "built: $REPO_ROOT/target/release/bowery-console"
echo "note:  this binary is tuned for THIS machine's CPU; don't copy it"
echo "       to a host with a different processor (it may SIGILL there)."
