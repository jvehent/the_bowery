#!/usr/bin/env bash
# prove-detections — make each detection fire, then check that it did.
#
#   scripts/prove-detections [peer-name]
#
# Reads `bowery_detections` from the local agent, provokes each rule with
# `bowery-prove`, reads the counters again, and reports which rules moved.
#
# WHY THIS EXISTS
#
# A rule at zero is either watching for something rare or unable to fire
# at all, and this codebase has found eight of the latter — every one with
# passing unit tests, because a unit test exercises the rule against an
# input the sensor may never deliver. Only the counter on a live host can
# tell the two apart.
#
# WHERE TO RUN IT
#
# On the host being provoked, and nowhere else: the provocations are local
# syscalls, so the agent that must see them is the local one. It needs the
# operator key and manifest (see deploy/remote/README.md).
#
# SAFETY
#
# `bowery-prove list` prints every action first. The write provocations
# open paths with neither O_CREAT nor O_TRUNC — the tracepoint fires on
# syscall entry, so intent is enough and nothing is created, truncated or
# written. Rules that cannot be provoked safely are named as such rather
# than skipped quietly.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Find the prover before doing anything else, so a missing binary fails
# here rather than after the counters have been read and the
# provocations half-run. Checked in the order of least surprise: an
# explicit override, then an installed copy, then this checkout's own
# build output — which is where it is on a host that builds from source,
# i.e. every host this was written for.
resolve_prover() {
    if [[ -n "${BOWERY_PROVE:-}" ]]; then
        command -v "$BOWERY_PROVE" >/dev/null 2>&1 && { echo "$BOWERY_PROVE"; return; }
        [[ -x "$BOWERY_PROVE" ]] && { echo "$BOWERY_PROVE"; return; }
        echo "BOWERY_PROVE is set to '$BOWERY_PROVE', which is not executable" >&2
        exit 2
    fi
    command -v bowery-prove >/dev/null 2>&1 && { command -v bowery-prove; return; }
    for candidate in "$REPO_ROOT/target/release/bowery-prove" "$REPO_ROOT/target/debug/bowery-prove"; do
        [[ -x "$candidate" ]] && { echo "$candidate"; return; }
    done
    cat >&2 <<MSG
cannot find the bowery-prove binary.

Build it from this checkout:
    cargo build --release -p bowery-prove

or point at one explicitly:
    BOWERY_PROVE=/path/to/bowery-prove $0
MSG
    exit 2
}
PROVER="$(resolve_prover)"

MANIFEST="${BOWERY_PEERS:-$HOME/.bowery/peers.toml}"
KEY="${BOWERY_OPERATOR_KEY:-$HOME/.bowery/operator.key}"
WANT_PEER="${1:-}"
SETTLE="${BOWERY_PROVE_SETTLE:-8}"

[[ -r "$MANIFEST" ]] || { echo "no peer manifest at $MANIFEST" >&2; exit 2; }
[[ -r "$KEY" ]] || { echo "no operator key at $KEY" >&2; exit 2; }

eval "$(python3 - "$MANIFEST" "$WANT_PEER" <<'PY'
import re, sys, shlex
text = open(sys.argv[1]).read()
want = sys.argv[2]
peers = [dict(re.findall(r'(\w+)\s*=\s*"([^"]+)"', b)) for b in text.split('[[peer]]')[1:]]
if not peers:
    sys.exit("no peers in manifest")
chosen = next((p for p in peers if p.get('name') == want), None) if want else peers[0]
if chosen is None:
    sys.exit(f"no peer named {want!r} in the manifest")
print(f"AGENT_NAME={shlex.quote(chosen.get('name','?'))}")
print(f"AGENT_ADDR={shlex.quote(chosen['addr'])}")
print(f"AGENT_FP={shlex.quote(chosen['fp'])}")
print(f"AGENT_PUB={shlex.quote(chosen['pubkey_b64'])}")
PY
)"

counters() {
    bowery exec sql --operator-key "$KEY" \
        --agent-addr "$AGENT_ADDR" --agent-fp "$AGENT_FP" --agent-pubkey-b64 "$AGENT_PUB" \
        --sql 'SELECT rule_id, fired_since_install FROM bowery_detections ORDER BY rule_id' \
        | tail -n +2
}

echo "==> agent:  $AGENT_NAME ($AGENT_ADDR)"
echo "==> prover: $PROVER"
echo "    provocations run locally, so this must be the local agent."
echo

before=$(mktemp); after=$(mktemp); runlog=$(mktemp)
trap 'rm -f "$before" "$after" "$runlog"' EXIT

counters > "$before"
echo "==> provoking"
# Teed so the diff step can read which provocations could not run at
# all: a rule whose tool is absent has not failed.
"$PROVER" run | tee "$runlog"
echo
echo "==> waiting ${SETTLE}s for the pipeline"
sleep "$SETTLE"
counters > "$after"

python3 - "$before" "$after" "$PROVER" "$runlog" <<'PY'
import subprocess, sys

def load(path):
    out = {}
    for line in open(path):
        c = line.rstrip("\n").split("\t")
        if len(c) >= 2:
            try:
                out[c[-2]] = int(c[-1])
            except ValueError:
                pass
    return out

before, after = load(sys.argv[1]), load(sys.argv[2])

listing = subprocess.run([sys.argv[3], "list"], capture_output=True, text=True).stdout
expected, unprovable = [], []
for line in listing.splitlines():
    parts = line.split(None, 1)
    if len(parts) != 2 or not parts[0].count("."):
        continue
    (unprovable if "NOT PROVABLE" in parts[1] else expected).append(parts[0])

# Provocations that could not run: the tool is not installed here, so
# the rule was never exercised and must not be counted against it.
could_not_run = {
    line.split("\t", 1)[1].strip()
    for line in open(sys.argv[4])
    if line.startswith("UNAVAILABLE\t")
}
expected = [r for r in expected if r not in could_not_run]

moved   = [r for r in expected if after.get(r, 0) > before.get(r, 0)]
# A rule that did not move but is already above zero was proved by an
# earlier run: the alert suppressor folds an identical finding — same
# rule, same path, same binary — and returns before the counter is
# touched. Running this twice inside that window is expected to look
# quiet, and reporting it as a failure would bury the one line that
# matters under thirty that do not.
folded  = [r for r in expected if r not in moved and after.get(r, 0) > 0]
never   = [r for r in expected if r not in moved and after.get(r, 0) == 0]

print(f"PROVED NOW ({len(moved)}/{len(expected)}):")
for r in moved:
    print(f"   {r:38} {before.get(r,0)} -> {after.get(r,0)}")
if folded:
    print(f"\nALREADY PROVEN ({len(folded)}) — nonzero, folded as a repeat this run:")
    for r in folded:
        print(f"   {r:38} at {after.get(r,0)}")
if never:
    print(f"\nNEVER FIRED ({len(never)}) — this is the finding:")
    for r in never:
        print(f"   {r}")
if could_not_run:
    print(f"\nTOOL NOT INSTALLED ({len(could_not_run)}) — untested here, not failed:")
    for r in sorted(could_not_run):
        print(f"   {r}")
if unprovable:
    print(f"\nNOT PROVABLE HERE ({len(unprovable)}) — stated, not skipped:")
    for r in unprovable:
        print(f"   {r}")

if not never:
    print("\nevery provocable rule has fired at least once on this host.")
# Only a rule still at zero is a failure.
sys.exit(1 if never else 0)
PY
